<sdf version="1.8">
  <world name="collapsed_building">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Simulation Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Disaster Zone Lighting: Dim directional sunlight and emergency ambient -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Damaged Concrete Ground Plane -->
    <model name="damaged_ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.40 0.40 0.38 1</ambient>
            <diffuse>0.45 0.45 0.42 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- COLLAPSED DISASTER ZONE: STRUCTURAL STEEL PILLARS        -->
    <!-- ======================================================== -->
    <model name="steel_pillar_1">
      <static>true</static>
      <pose>-1.66 1.40 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>2.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>2.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.65 0.28 0.12 1</ambient>
            <diffuse>0.72 0.32 0.15 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="steel_pillar_2">
      <static>true</static>
      <pose>1.92 1.87 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>2.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>2.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.25 0.30 0.35 1</ambient>
            <diffuse>0.32 0.38 0.44 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- COLLAPSED DISASTER ZONE: FALLEN CONCRETE SLABS           -->
    <!-- ======================================================== -->
    <model name="fallen_slab_1">
      <static>true</static>
      <pose>0.25 1.96 0.18 0.08 0.12 0.45</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.50 0.70 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.50 0.70 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.48 0.48 0.48 1</ambient>
            <diffuse>0.52 0.52 0.52 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="fallen_slab_2">
      <static>true</static>
      <pose>0.95 -0.33 0.18 -0.07 0.10 -0.38</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.70 0.50 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.70 0.50 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.49 0.47 1</ambient>
            <diffuse>0.55 0.54 0.52 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- COLLAPSED DISASTER ZONE: BROKEN RUBBLE BLOCKS            -->
    <!-- ======================================================== -->
    <model name="rubble_block_1">
      <static>true</static>
      <pose>-1.80 -1.09 0.18 0.04 -0.08 0.72</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.35 0.35 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.35 0.35 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.32 0.26 1</ambient>
            <diffuse>0.60 0.36 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rubble_block_2">
      <static>true</static>
      <pose>-0.12 -1.89 0.18 -0.05 0.07 -0.55</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.35 0.35 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.35 0.35 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.47 0.47 0.47 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rubble_block_3">
      <static>true</static>
      <pose>1.87 -1.24 0.18 0.08 0.04 0.28</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box>
              <size>0.35 0.35 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box>
              <size>0.35 0.35 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.46 0.44 0.40 1</ambient>
            <diffuse>0.50 0.48 0.44 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================================================== -->
    <!-- DISASTER SITE BOUNDARY BARRIERS                          -->
    <!-- ======================================================== -->
    <model name="boundary_north">
      <static>true</static>
      <pose>0 4.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.0 0.40 0.90</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.0 0.40 0.90</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.40 0.40 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_south">
      <static>true</static>
      <pose>0 -4.8 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.0 0.40 0.90</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.0 0.40 0.90</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.40 0.40 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_east">
      <static>true</static>
      <pose>4.8 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.40 10.0 0.90</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 10.0 0.90</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.40 0.40 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="boundary_west">
      <static>true</static>
      <pose>-4.8 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.40 10.0 0.90</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 10.0 0.90</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.40 0.40 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
